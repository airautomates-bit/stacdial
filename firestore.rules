rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // products/{productId}: catalogue, price, inventory and editorial data.
    // settings/store: private store configuration and integration settings.
    // orders/{orderId}: customer PII, price snapshots and internal workflow data.
    // users/{userId}: private Firebase customer profile data.
    // claims/{claimId}: first-purchase offer state.
    // loyaltyOffers/{code}: phone-bound private discount state.
    // media/{mediaId}: server-managed media metadata.
    // rates/{rateId}: server-managed abuse-prevention counters.
    // requestKeys/{key}: server-managed idempotency records.
    // audit/{auditId}: administrator audit records.
    //
    // All application access currently flows through authenticated Next.js
    // server routes using Firebase Admin. Admin SDK requests bypass these
    // client rules, so no customer PII or management data needs client access.

    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function uidUnchanged() { return request.resource.data.uid == request.auth.uid; }
    function uidNotModified() { return request.resource.data.uid == resource.data.uid; }
    function hasOnlyAllowedFields(fields) { return request.resource.data.keys().hasOnly(fields); }
    function isValidUser(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
        data.email is string && data.email.size() > 3 && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() <= 100 &&
        data.created is timestamp && data.updated is timestamp;
    }

    // Prototype policy: browsers cannot read or write Firestore directly.
    // Customer and admin requests are validated by server routes and executed
    // with Firebase Admin credentials. Everything else is denied by default.
    match /{document=**} {
      allow read, create, update, delete: if false;
    }
  }
}
